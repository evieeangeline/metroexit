TFNSW_API_KEY=

# Station surveys (/contribute). On Vercel these come from the Upstash Redis
# integration; locally, `vercel env pull` fills them in. Without them, `npm run dev`
# prints submissions to the terminal instead of storing them.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any long random string, e.g. `openssl rand -hex 24`. Needed to read submissions back.
ADMIN_TOKEN=

KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=