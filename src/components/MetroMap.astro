---
import { stations, railways, lineInfo, statusInfo, type Station } from '../data/metro';
import { LIVE_TRAINS } from '../config';
import { project, smoothPath, smoothSegments, viewBox, type Pt } from '../lib/geo';

const pt = (s: Station) => project(s.lat, s.lon);

// One continuous curve from Tallawong to Sydenham, split at Chatswood so the
// two lines meet smoothly but keep their own colours.
const main = stations.filter((s) => s.line !== 'bankstown');
const mainPts = main.map(pt);
const segs = smoothSegments(mainPts);
const split = main.findIndex((s) => s.id === 'chatswood');
const start = (p: Pt) => `M${p[0]},${p[1]} `;
const nwPath = start(mainPts[0]) + segs.slice(0, split).join(' ');
const cityPath = start(mainPts[split]) + segs.slice(split).join(' ');
const routePath = start(mainPts[0]) + segs.join(' ');

const sydenham = stations.find((s) => s.id === 'sydenham')!;
const bankstownPts = [sydenham, ...stations.filter((s) => s.line === 'bankstown')].map(pt);
const bankstownPath = smoothPath(bankstownPts);

const railPaths = railways.map((run) => smoothPath(run.map(([lat, lon]) => project(lat, lon))));

function label(s: Station, pos = s.pos) {
  switch (pos) {
    case 'r':
      return { x: 12, y: 4.8, anchor: 'start', rot: 0 };
    case 'l':
      return { x: -12, y: 4.8, anchor: 'end', rot: 0 };
    case 't':
      return { x: 0, y: -13, anchor: 'middle', rot: 0 };
    case 'b':
      return { x: 0, y: 23, anchor: 'middle', rot: 0 };
    case 'rot':
      return { x: -6, y: 13, anchor: 'end', rot: -58 };
  }
}

const stationData = Object.fromEntries(
  stations.map((s) => [
    s.id,
    {
      name: s.name,
      line: lineInfo[s.line].name,
      lineKey: s.line,
      chip: statusInfo[s.status].chip,
      blurb: statusInfo[s.status].blurb,
      status: s.status,
      interchange: !!s.interchange,
    },
  ]),
);
---

<section class="map-wrap" aria-label="Sydney Metro map">
  <div class="map-scroll">
    <svg
      class="map"
      viewBox={`0 0 ${viewBox.width} ${viewBox.height}`}
      role="group"
      aria-label="Interactive map of Sydney Metro stations"
    >
      <defs>
        <pattern id="dotgrid" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="7" cy="7" r="0.9" fill="var(--grid)" />
        </pattern>
        <radialGradient id="fade" cx="50%" cy="50%" r="60%">
          <stop offset="55%" stop-color="#fff" />
          <stop offset="100%" stop-color="#000" />
        </radialGradient>
        <mask id="fade-mask">
          <rect width="100%" height="100%" fill="url(#fade)" />
        </mask>
      </defs>

      <rect width="100%" height="100%" fill="url(#dotgrid)" mask="url(#fade-mask)" />

      <g class="rails" mask="url(#fade-mask)">
        {railPaths.map((d) => (
          <path d={d} />
        ))}
      </g>

      <g class="lines">
        <path class="line line-bankstown" id="route-bankstown" d={bankstownPath} />
        <path class="line line-nw draw" d={nwPath} pathLength="1" />
        <path class="line line-city draw" d={cityPath} pathLength="1" />
        <path id="route" d={routePath} fill="none" stroke="none" />
      </g>

      <g class="trains" aria-hidden="true"></g>

      <g class="stations">
        {stations.map((s, i) => {
          const [x, y] = pt(s);
          const l = label(s);
          return (
            <g
              class:list={['stn', `stn-${s.line}`, { interchange: s.interchange, key: s.key }]}
              data-id={s.id}
              data-x={x}
              data-y={y}
              transform={`translate(${x} ${y})`}
              tabindex="0"
              role="button"
              aria-label={`${s.name} station, ${statusInfo[s.status].chip}`}
              style={`--i:${i}`}
            >
              <g class="pop">
                <circle class="hit" r="15" />
                <circle class="dot" r="6" />
                <text x={l.x} y={l.y} text-anchor={l.anchor} transform={l.rot ? `rotate(${l.rot})` : undefined}>
                  {s.label ?? s.name}
                </text>
                {s.key &&
                  (() => {
                    const k = label(s, s.keyPos ?? s.pos);
                    return (
                      <text class="key-label" x={k.x * 2.2} y={k.y * 2.2} text-anchor={k.anchor} aria-hidden="true">
                        {s.label ?? s.name}
                      </text>
                    );
                  })()}
              </g>
            </g>
          );
        })}
      </g>
    </svg>
  </div>
  <p class="live-chip" data-mode="loading" aria-live="polite" hidden={!LIVE_TRAINS}>
    <span class="live-dot" aria-hidden="true"></span>
    <span class="live-text">finding metros…</span>
  </p>

  <script type="application/json" id="station-data" set:html={JSON.stringify(stationData)} />
</section>

<style>
  .map-wrap {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .map-scroll {
    width: 100%;
    height: 100%;
  }
  .map {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    font-family: var(--font);
  }

  .rails path {
    fill: none;
    stroke: var(--rail);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line {
    fill: none;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .line-nw {
    stroke: var(--line-nw);
  }
  .line-city {
    stroke: var(--line-city);
  }
  .line-bankstown {
    stroke: var(--line-city);
    stroke-width: 6;
    stroke-dasharray: 0.01 9;
  }

  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.6s cubic-bezier(0.6, 0, 0.3, 1) forwards;
  }
  .line-city.draw {
    animation-delay: 1.1s;
    animation-duration: 0.9s;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Trains are created by the script, so they don't get Astro's scoped-style
     attribute: style them through the (scoped) .trains layer with :global(). */
  .trains {
    pointer-events: none;
  }
  .trains :global(.mini-train) {
    opacity: 0;
    transition: opacity 0.6s;
  }
  .trains :global(.mini-train.on) {
    opacity: 1;
  }
  .trains :global(.shape),
  .trains :global(.ping) {
    transform: scale(var(--ts, 1));
  }
  .trains :global(rect) {
    fill: var(--ink);
    stroke: #fff;
    stroke-width: 1.5;
  }
  .trains :global(.shape circle) {
    fill: var(--line-city);
  }
  .trains :global(.ping) {
    fill: none;
    stroke: var(--line-city);
    stroke-width: 2;
    opacity: 0;
  }
  .trains :global(.pinged .ping) {
    animation: ping 1.2s ease-out;
  }
  @keyframes ping {
    from {
      opacity: 0.9;
      transform: scale(calc(var(--ts, 1) * 0.6));
    }
    to {
      opacity: 0;
      transform: scale(calc(var(--ts, 1) * 2.4));
    }
  }

  .live-chip[hidden] {
    display: none;
  }
  .live-chip {
    position: absolute;
    top: 16px;
    right: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 99px;
    background: var(--bg);
    border: 1.5px solid var(--rail);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink);
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--muted);
  }
  .live-chip[data-mode='live'] .live-dot {
    background: #1fb36b;
    box-shadow: 0 0 0 0 rgb(31 179 107 / 0.6);
    animation: pulse 2s infinite;
  }
  .live-chip[data-mode='sim'] .live-text {
    color: var(--muted);
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 7px rgb(31 179 107 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(31 179 107 / 0);
    }
  }

  /* Stations */
  .stn {
    cursor: pointer;
    outline: none;
  }
  .stn .hit {
    fill: transparent;
  }
  .stn .dot {
    fill: #fff;
    stroke: var(--line-nw);
    stroke-width: 2.8;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(var(--s, 1));
    transition:
      transform 0.25s cubic-bezier(0.3, 1.8, 0.5, 1),
      fill 0.15s;
  }
  .stn .pop {
    transform-origin: 0 0;
    transform: scale(0);
    animation: pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) forwards;
    animation-delay: calc(0.25s + var(--i) * 0.055s);
  }
  .stn-city .dot,
  .stn-bankstown .dot {
    stroke: var(--line-city);
  }
  .stn.interchange .dot {
    stroke: var(--ink);
    stroke-width: 3;
  }
  @keyframes pop {
    to {
      transform: scale(1);
    }
  }

  .stn text {
    font-size: 14px;
    font-weight: 600;
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
    transition: fill 0.15s;
  }
  .stn-bankstown text {
    font-size: 12.5px;
  }
  .stn .key-label {
    display: none;
  }

  .stn:hover .dot,
  .stn:focus-visible .dot,
  .stn.active .dot {
    transform: scale(calc(var(--s, 1) * 1.6));
    fill: var(--accent);
    stroke: var(--ink);
  }
  .stn:hover text,
  .stn:focus-visible text,
  .stn.active text {
    fill: var(--line-nw);
    font-weight: 800;
  }

  /* Phones: the whole map fits the width as an overview. Only key stations are
     labelled; the line diagram below the map is for picking stations. */
  @media (max-width: 720px) {
    .map-wrap {
      height: auto;
    }
    .map {
      height: auto;
    }
    .line {
      stroke-width: 11;
    }
    .line-bankstown {
      stroke-width: 10;
      stroke-dasharray: 0.01 15;
    }
    .rails path {
      stroke-width: 4;
    }
    .stn {
      --s: 1.7;
    }
    .stn .hit {
      r: 22px;
    }
    .stn text {
      display: none;
    }
    .stn .key-label {
      display: block;
      font-size: 30px;
      font-weight: 700;
      stroke-width: 7px;
    }
    .trains {
      --ts: 2;
    }
    .live-chip {
      top: 0;
      right: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .draw {
      animation: none;
      stroke-dashoffset: 0;
    }
    .stn .pop {
      animation: none;
      transform: none;
    }
    .live-chip[data-mode='live'] .live-dot {
      animation: none;
    }
    .trains :global(.pinged .ping) {
      animation: none;
    }
  }
</style>

<script>
  import { project } from '../lib/geo';
  import { LIVE_TRAINS } from '../config';

  type Info = {
    name: string;
    line: string;
    lineKey: string;
    chip: string;
    blurb: string;
    status: string;
    interchange: boolean;
  };

  const wrap = document.querySelector<HTMLElement>('.map-wrap')!;
  const data: Record<string, Info> = JSON.parse(document.getElementById('station-data')!.textContent!);
  const card = document.querySelector<HTMLElement>('.card')!;
  const empty = card.querySelector<HTMLElement>('.card-empty')!;
  const body = card.querySelector<HTMLElement>('.card-body')!;
  const stns = [...wrap.querySelectorAll<SVGGElement>('.stn')];
  let pinned: string | null = null;

  function show(id: string | null) {
    if (!id) {
      empty.hidden = false;
      body.hidden = true;
      delete card.dataset.status;
      return;
    }
    const s = data[id];
    empty.hidden = true;
    body.hidden = false;
    card.dataset.status = s.status;
    body.querySelector('.card-line')!.textContent = s.interchange ? `${s.line} · interchange` : s.line;
    body.querySelector('.card-name')!.textContent = s.name;
    body.querySelector('.card-chip')!.textContent = s.chip;
    body.querySelector('.card-blurb')!.textContent = s.blurb;
    body.querySelector<HTMLAnchorElement>('.card-help')!.href = `/contribute?station=${id}`;
  }

  // Stations can be picked from the map or from the line diagram on phones.
  const strip = [...document.querySelectorAll<HTMLElement>('.strip-stn')];

  function pin(id: string | null) {
    pinned = id && pinned !== id ? id : null;
    for (const el of [...stns, ...strip]) el.classList.toggle('active', el.dataset.id === pinned);
    strip.forEach((el) => el.setAttribute('aria-pressed', String(el.dataset.id === pinned)));
    card.classList.toggle('open', !!pinned);
    show(pinned);
    if (pinned) document.dispatchEvent(new CustomEvent('station-picked', { detail: data[pinned].lineKey }));
  }

  for (const g of stns) {
    const id = g.dataset.id!;
    g.addEventListener('mouseenter', () => show(id));
    g.addEventListener('mouseleave', () => show(pinned));
    g.addEventListener('click', () => pin(id));
    g.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        pin(id);
      }
    });
  }
  for (const b of strip) b.addEventListener('click', () => pin(b.dataset.id!));
  card.querySelector('.card-close')?.addEventListener('click', () => pin(null));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && pin(null));

  // ── Metro trains ───────────────────────────────────────────────────────
  // Live positions come from /api/metros (TfNSW GTFS-realtime, proxied). If the
  // feed isn't available, or LIVE_TRAINS is off (src/config.ts), one simulated
  // train shuttles along the line instead.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const layer = wrap.querySelector<SVGGElement>('.trains')!;
  const chip = wrap.querySelector<HTMLElement>('.live-chip')!;
  const chipText = chip.querySelector<HTMLElement>('.live-text')!;
  const SVGNS = 'http://www.w3.org/2000/svg';
  const POLL = 10000;
  const SNAP = 30; // svg units (~1.3 km): further than this from a line, draw the raw position

  type Sample = { path: SVGPathElement; l: number; x: number; y: number };
  const paths = [
    wrap.querySelector<SVGPathElement>('#route')!,
    wrap.querySelector<SVGPathElement>('#route-bankstown')!,
  ];
  const samples: Sample[] = [];
  for (const path of paths) {
    const total = path.getTotalLength();
    for (let l = 0; l <= total; l += 1.5) {
      const p = path.getPointAtLength(l);
      samples.push({ path, l, x: p.x, y: p.y });
    }
  }
  const nearest = (x: number, y: number) => {
    let best = samples[0];
    let bestD = Infinity;
    for (const s of samples) {
      const d = (s.x - x) ** 2 + (s.y - y) ** 2;
      if (d < bestD) {
        best = s;
        bestD = d;
      }
    }
    return { sample: best, dist: Math.sqrt(bestD) };
  };

  const angleAt = (path: SVGPathElement, l: number) => {
    const total = path.getTotalLength();
    const a = path.getPointAtLength(Math.max(0, l - 1));
    const b = path.getPointAtLength(Math.min(total, l + 1));
    return (Math.atan2(b.y - a.y, b.x - a.x) * 180) / Math.PI;
  };

  /** Where a train is drawn: either a point along one of the lines (on one side
   *  of it, by direction of travel), or a free point. */
  type Spot = { path: SVGPathElement; l: number; side: number } | { x: number; y: number; angle: number };

  const TRACK_GAP = 4.5; // svg units either side of the line's centre

  const resolve = (spot: Spot) => {
    if ('path' in spot) {
      const p = spot.path.getPointAtLength(spot.l);
      const angle = angleAt(spot.path, spot.l);
      const rad = (angle * Math.PI) / 180;
      const off = spot.side * TRACK_GAP;
      return { x: p.x - Math.sin(rad) * off, y: p.y + Math.cos(rad) * off, angle };
    }
    return spot;
  };

  const lerpSpot = (a: Spot, b: Spot, t: number): Spot => {
    if ('path' in a && 'path' in b && a.path === b.path)
      return { path: a.path, l: a.l + (b.l - a.l) * t, side: a.side + (b.side - a.side) * t };
    const ra = resolve(a);
    const rb = resolve(b);
    return { x: ra.x + (rb.x - ra.x) * t, y: ra.y + (rb.y - ra.y) * t, angle: t < 0.5 ? ra.angle : rb.angle };
  };

  function makeTrain() {
    const g = document.createElementNS(SVGNS, 'g');
    g.setAttribute('class', 'mini-train');
    g.innerHTML =
      '<circle class="ping" r="9"/>' +
      '<g class="shape"><rect x="-12" y="-5" width="24" height="10" rx="5"/>' +
      '<circle cx="-4.5" cy="0" r="1.6"/><circle cx="0.5" cy="0" r="1.6"/><circle cx="5.5" cy="0" r="1.6"/></g>';
    layer.append(g);
    return g;
  }

  const draw = (g: SVGGElement, spot: Spot) => {
    const { x, y, angle } = resolve(spot);
    g.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${angle.toFixed(1)})`);
  };

  // ── live mode ──
  // The feed gives a position roughly every 10 s, already ~10 s old. Rather than
  // gliding between raw fixes (which leaves trains parked mid-tunnel while they
  // wait for the next one), each train keeps moving at its measured speed from
  // its last fix, but never past the next station in its direction of travel.
  // So trains only ever stop at stations, and wait there until the data says
  // they've left.
  const UNITS_PER_KM = 23.4; // see SCALE in lib/geo.ts (2600 units per degree of latitude)
  const V_MAX = (100 / 3.6 / 1000) * UNITS_PER_KM; // 100 km/h, in units per second
  const V_TYPICAL = (55 / 3.6 / 1000) * UNITS_PER_KM; // until we've measured a train's speed
  const AT_STATION = 0.17 * UNITS_PER_KM; // within a platform length of a station
  const MAX_LAG = 10; // units the drawn train may run ahead of the data before easing back

  // Station positions along each path, in path-length units.
  const stopsOn = new Map<SVGPathElement, number[]>();
  for (const path of paths) {
    const own = samples.filter((smp) => smp.path === path);
    const ls = stns
      .filter((g) => (path === paths[0]) !== g.classList.contains('stn-bankstown') || g.dataset.id === 'sydenham')
      .map((g) => {
        const x = +g.dataset.x!;
        const y = +g.dataset.y!;
        let best = own[0];
        for (const smp of own)
          if ((smp.x - x) ** 2 + (smp.y - y) ** 2 < (best.x - x) ** 2 + (best.y - y) ** 2) best = smp;
        return best.l;
      })
      .sort((a, b) => a - b);
    stopsOn.set(path, ls);
  }
  const stationAt = (path: SVGPathElement, l: number) =>
    stopsOn.get(path)!.find((s) => Math.abs(s - l) <= AT_STATION) ?? null;
  const nextStop = (path: SVGPathElement, l: number, dir: number) => {
    const ls = stopsOn.get(path)!;
    return dir > 0
      ? (ls.find((s) => s > l + 0.5) ?? path.getTotalLength())
      : ([...ls].reverse().find((s) => s < l - 0.5) ?? 0);
  };

  type OnLine = {
    kind: 'line';
    g: SVGGElement;
    path: SVGPathElement;
    dir: number; // +1 = towards the end of the path, -1 = towards the start
    lObs: number; // last observed position
    tObs: number; // when it was observed (feed time, ms)
    v: number; // units per second; 0 while dwelling
    shown: number; // where it's drawn now
  };
  type OffLine = { kind: 'free'; g: SVGGElement; from: Spot; to: Spot; t0: number };
  type Live = OnLine | OffLine;
  const live = new Map<string, Live>();
  let animating = false;
  let last = performance.now();

  function target(tr: OnLine) {
    if (tr.v === 0) return stationAt(tr.path, tr.lObs) ?? tr.lObs;
    const ahead = tr.lObs + tr.dir * tr.v * Math.max(0, (Date.now() - tr.tObs) / 1000);
    const stop = nextStop(tr.path, tr.lObs, tr.dir);
    return tr.dir > 0 ? Math.min(ahead, stop) : Math.max(ahead, stop);
  }

  function frame(now: number) {
    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    for (const tr of live.values()) {
      if (tr.kind === 'free') {
        draw(tr.g, lerpSpot(tr.from, tr.to, reduced ? 1 : Math.min(1, (now - tr.t0) / POLL)));
        continue;
      }
      const goal = target(tr);
      const gap = (goal - tr.shown) * tr.dir; // > 0: goal is ahead
      if (reduced) tr.shown = goal;
      // Ahead: chase the goal smoothly. Slightly behind: wait rather than reverse.
      // Far behind (the data disagrees a lot): ease back.
      else if (gap > 0 || -gap > MAX_LAG) tr.shown += (goal - tr.shown) * (1 - Math.exp(-dt * 2.5));
      draw(tr.g, { path: tr.path, l: tr.shown, side: tr.dir });
    }
    if (live.size) requestAnimationFrame(frame);
    else animating = false;
  }

  type Metro = { id: string; lat: number; lon: number; bearing: number | null };

  function update(metros: Metro[], feedTime: number) {
    const seen = new Set<string>();
    for (const m of metros) {
      seen.add(m.id);
      const [x, y] = project(m.lat, m.lon);
      const { sample, dist } = nearest(x, y);
      const tr = live.get(m.id);

      // Too far from any line to snap (e.g. a depot): just glide between fixes.
      if (dist > SNAP) {
        const spot: Spot = { x, y, angle: m.bearing != null ? m.bearing - 90 : 0 };
        if (tr?.kind === 'free') {
          tr.from = lerpSpot(tr.from, tr.to, Math.min(1, (performance.now() - tr.t0) / POLL));
          tr.to = spot;
          tr.t0 = performance.now();
        } else {
          const g = tr?.g ?? makeTrain();
          live.set(m.id, { kind: 'free', g, from: spot, to: spot, t0: performance.now() });
          draw(g, spot);
          if (!tr) requestAnimationFrame(() => g.classList.add('on'));
        }
        continue;
      }

      const { path, l } = sample;
      // Direction of travel from the compass bearing vs the line's direction.
      let dir = 0;
      if (m.bearing != null) {
        const heading = ((m.bearing - 90) * Math.PI) / 180; // compass → svg angle
        const along = (angleAt(path, l) * Math.PI) / 180;
        dir = Math.cos(heading - along) >= 0 ? 1 : -1;
      }

      if (tr?.kind === 'line' && tr.path === path) {
        dir ||= Math.sign(l - tr.lObs) || tr.dir;
        const dt = (feedTime - tr.tObs) / 1000;
        const moved = (l - tr.lObs) * dir;
        const atStop = stationAt(path, l) !== null;
        // The feed loses trains in tunnels and keeps repeating their last fix.
        // A repeated fix away from a station is stale: keep predicting from the
        // last real one, so the train carries on to the next station and waits.
        const stale = !atStop && Math.abs(moved) < 0.3 && dir === tr.dir;
        if (dt > 0 && !stale) {
          if (atStop && Math.abs(moved) < 1.5)
            tr.v = 0; // dwelling at a platform
          else if (moved > 0.3) tr.v = Math.min(V_MAX, tr.v ? (tr.v + moved / dt) / 2 : moved / dt);
          else if (tr.v === 0) tr.v = V_TYPICAL; // just pulled out
          if (dir !== tr.dir) tr.shown = l; // changed direction (terminus): jump to the fix
          tr.dir = dir;
          tr.lObs = l;
          tr.tObs = feedTime;
        }
        ping(tr.g);
      } else {
        const g = tr?.g ?? makeTrain();
        live.set(m.id, {
          kind: 'line',
          g,
          path,
          dir: dir || 1,
          lObs: l,
          tObs: feedTime,
          v: stationAt(path, l) !== null ? 0 : V_TYPICAL,
          shown: l,
        });
        draw(g, { path, l, side: dir || 1 });
        if (!tr) requestAnimationFrame(() => g.classList.add('on'));
      }
    }
    for (const [id, tr] of live) {
      if (seen.has(id)) continue;
      tr.g.classList.remove('on');
      setTimeout(() => tr.g.remove(), 700);
      live.delete(id);
    }
    if (!animating && live.size) {
      animating = true;
      last = performance.now();
      requestAnimationFrame(frame);
    }
    count = metros.length;
    chip.dataset.mode = 'live';
    tick();
  }

  // Restart the ring animation so each refresh is visible, even for trains
  // that only crept a few pixels or are waiting at a station.
  const ping = (g: SVGGElement) => {
    g.classList.remove('pinged');
    void g.getBoundingClientRect();
    g.classList.add('pinged');
  };

  // Chip: "16 metros live · updated 4s ago", ticking every second.
  let count = 0;
  let updatedAt = 0;
  function tick() {
    if (chip.dataset.mode !== 'live') return;
    const ago = Math.max(0, Math.round((Date.now() - updatedAt) / 1000));
    const trains = count === 0 ? 'no metros running' : `${count} metro${count === 1 ? '' : 's'} live`;
    chipText.textContent = `${trains} · updated ${ago}s ago`;
  }
  setInterval(tick, 1000);

  // ── simulated fallback: one train stopping at every station ──
  let sim: SVGGElement | null = null;

  function startSim() {
    chip.dataset.mode = 'sim';
    chipText.textContent = 'live data offline · simulated';
    if (sim || reduced) return;
    const route = paths[0];
    const stops = stns
      .filter((g) => !g.classList.contains('stn-bankstown'))
      .map((g) => nearest(+g.dataset.x!, +g.dataset.y!).sample.l)
      .sort((a, b) => a - b);
    const SPEED = 95; // svg units per second
    const DWELL = 650;
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    const g = (sim = makeTrain());
    let idx = 0;
    let dir = 1;
    const hop = () => {
      if (sim !== g) return;
      const next = idx + dir;
      if (next < 0 || next >= stops.length) {
        dir = -dir;
        setTimeout(hop, DWELL * 3);
        return;
      }
      const from = stops[idx];
      const to = stops[next];
      const dur = (Math.abs(to - from) / SPEED) * 1000 + 300;
      const t0 = performance.now();
      const step = (now: number) => {
        if (sim !== g) return;
        const t = Math.min(1, (now - t0) / dur);
        draw(g, { path: route, l: from + (to - from) * ease(t), side: 0 });
        if (t < 1) requestAnimationFrame(step);
        else {
          idx = next;
          setTimeout(hop, DWELL);
        }
      };
      requestAnimationFrame(step);
    };
    draw(g, { path: route, l: stops[0], side: 0 });
    requestAnimationFrame(() => g.classList.add('on'));
    setTimeout(hop, DWELL);
  }

  function stopSim() {
    if (!sim) return;
    const g = sim;
    sim = null;
    g.classList.remove('on');
    setTimeout(() => g.remove(), 700);
  }

  // ── polling ──
  let timer: number | undefined;
  let configured = true;
  let inflight = false;

  async function poll() {
    // Only ever one polling loop, however many times poll() is triggered.
    if (inflight) return;
    inflight = true;
    clearTimeout(timer);
    let retry = POLL;
    try {
      const res = await fetch('/api/metros', { cache: 'no-store' });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        // No API key on the server: stay simulated and stop asking.
        if (err.error === 'not-configured') configured = false;
        retry = 60000;
        throw new Error(err.error ?? res.statusText);
      }
      const { metros, updated } = (await res.json()) as { metros: Metro[]; updated: number };
      updatedAt = Math.min(updated, Date.now());
      stopSim();
      update(metros, updatedAt);
    } catch {
      if (!live.size) startSim();
    }
    inflight = false;
    clearTimeout(timer);
    if (configured && !document.hidden) timer = window.setTimeout(poll, retry);
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) clearTimeout(timer);
    else if (configured) poll();
  });

  // let the lines draw in first
  if (LIVE_TRAINS) setTimeout(poll, reduced ? 0 : 2000);
  else setTimeout(startSim, 2000);
</script>
