---
// Filled in by the script in MetroMap.astro when a station is hovered or picked.
---

<aside class="card" aria-live="polite">
  <div class="card-empty">
    <p class="card-kicker">where are you getting off?</p>
    <p class="card-hint">Pick a station on the map to see where it’s at.</p>
  </div>
  <div class="card-body" hidden>
    <button class="card-close" type="button" aria-label="Close">
      ×
    </button>
    <p class="card-line"></p>
    <h2 class="card-name"></h2>
    <div class="carriages" aria-hidden="true">
      {Array.from({ length: 6 }, () => (
        <span class="car">
          <i></i>
          <i></i>
          <i></i>
        </span>
      ))}
    </div>
    <p class="card-chip"></p>
    <p class="card-blurb"></p>
    <a class="card-help" href="/contribute">
      On this platform? Help map it →
    </a>
  </div>
</aside>

<style>
  .card {
    width: 100%;
    max-width: 320px;
    padding: 16px 18px;
    background: var(--bg);
    border: 2px solid var(--ink);
    border-radius: 16px;
    box-shadow: 5px 5px 0 var(--line-city);
    transform: rotate(-1.5deg);
  }
  .card p,
  .card h2 {
    margin: 0;
  }
  .card-kicker {
    font-weight: 700;
    font-size: 15px;
  }
  .card-hint {
    color: var(--muted);
    font-size: 13px;
    margin-top: 4px !important;
  }
  .card-line {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .card-name {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.1;
    margin: 2px 0 10px !important;
  }
  .card-chip {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 99px;
    background: var(--chip-bg, #e8f4f5);
    color: var(--chip-fg, var(--line-nw));
    margin-top: 10px !important;
  }
  .card[data-status='mapping'] {
    --chip-bg: #fff4d6;
    --chip-fg: #8a5a00;
  }
  .card[data-status='soon'] {
    --chip-bg: #eef0f1;
    --chip-fg: #5d6a6d;
  }
  .card-blurb {
    font-size: 13px;
    line-height: 1.4;
    margin-top: 8px !important;
    color: #3f4b4e;
  }

  .card-help {
    display: inline-block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
    text-underline-offset: 3px;
  }
  .card[data-status='soon'] .card-help {
    display: none;
  }

  .carriages {
    display: flex;
    gap: 3px;
  }
  .car {
    flex: 1;
    height: 16px;
    border: 1.8px solid var(--ink);
    border-radius: 4px;
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    background: #fff;
  }
  .car:first-child {
    border-top-left-radius: 9px;
  }
  .car:last-child {
    border-top-right-radius: 9px;
  }
  .car i {
    width: 3px;
    height: 8px;
    border-radius: 2px;
    background: var(--line-city);
    animation: blink 1.6s infinite;
  }
  .card[data-status='ready'] .car i {
    animation-name: shimmer;
  }
  .car:nth-child(2) i {
    animation-delay: 0.1s;
  }
  .car:nth-child(3) i {
    animation-delay: 0.2s;
  }
  .car:nth-child(4) i {
    animation-delay: 0.3s;
  }
  .car:nth-child(5) i {
    animation-delay: 0.4s;
  }
  .car:nth-child(6) i {
    animation-delay: 0.5s;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @keyframes shimmer {
    50% {
      background: var(--accent);
    }
  }

  .card {
    position: relative;
  }
  .card-close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font: 600 22px/1 var(--font);
    color: var(--muted);
    cursor: pointer;
    display: none;
  }
  .card-close:hover {
    background: #eef0f1;
    color: var(--ink);
  }

  /* Phones: the card is a sheet that slides up once a station is picked. */
  @media (max-width: 720px) {
    .card {
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom));
      width: auto;
      max-width: none;
      z-index: 10;
      transform: translateY(calc(100% + 40px));
      visibility: hidden;
      transition:
        transform 0.35s cubic-bezier(0.3, 1.3, 0.5, 1),
        visibility 0s 0.35s;
    }
    .card.open {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }
    .card-empty {
      display: none;
    }
    .card-close {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .car i {
      animation: none;
    }
  }
</style>
