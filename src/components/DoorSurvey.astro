---
// The door survey inside the station card. It follows the station picked on
// the map (MetroMap sets data-pinned and data-shown on .card) and posts to
// /api/submissions. See docs/contributions.md.
import { DOOR_NUMBERS, FEATURES } from '../lib/survey';
import { featureIcons } from '../lib/icons';

// Six carriages of three doors, door 4 at the south (Bankstown) end.
const cars = Array.from({ length: DOOR_NUMBERS.length / 3 }, (_, i) => DOOR_NUMBERS.slice(i * 3, i * 3 + 3));
const sides = [
  { value: 'tallawong', label: 'To Tallawong' },
  { value: 'bankstown', label: 'To Bankstown' },
  { value: 'both', label: 'Both sides' },
];
const short: Record<string, string> = { accessible: 'Accessible', help: 'Help point' };
---

<div class="survey" hidden>
  <svg class="sprite" aria-hidden="true">
    {Object.entries(featureIcons).map(([key, paths]) => (
      <symbol
        id={`i-${key}`}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={paths}
      />
    ))}
  </svg>

  <form class="survey-form" novalidate>
    <p class="survey-title">On the platform? Help map it</p>
    <div class="sides" role="radiogroup" aria-label="Which platform">
      {sides.map((s) => (
        <label>
          <input type="radio" name="platform" value={s.value} />
          <b>{s.label}</b>
        </label>
      ))}
    </div>

    <p class="train-end">← Bankstown end</p>
    <div class="cars">
      {cars.map((doors) => (
        <div class="car">
          {doors.map((n) => (
            <button type="button" class="door" data-door={n} aria-pressed="false">
              <span>{n}</span>
              <span class="door-icons" aria-hidden="true" />
            </button>
          ))}
        </div>
      ))}
    </div>
    <p class="train-end right">Tallawong end →</p>

    <p class="pick-door">Tap the door you’re next to.</p>
    <div class="features" hidden>
      <p class="features-title">
        At door <b class="panel-door"></b>:
      </p>
      <div class="feature-grid">
        {Object.entries(FEATURES).map(([key, label]) => (
          <button type="button" class="feature" data-feature={key} aria-pressed="false">
            <svg aria-hidden="true">
              <use href={`#i-${key}`} />
            </svg>
            {short[key] ?? label}
          </button>
        ))}
      </div>
    </div>

    <p class="door-check" hidden>
      New line! If the doors here aren’t numbered 4 to 21, tell us below.
    </p>
    <input class="notes" name="notes" maxlength="2000" placeholder="Anything else? (optional)" />
    <!-- Hidden from people, tempting to bots. -->
    <input class="trap" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="send-row">
      <button type="submit" class="send">
        Send
      </button>
      <p class="status" role="status" aria-live="polite"></p>
    </div>
  </form>

  <div class="survey-done" hidden>
    <p class="done-title">Thanks &lt;3</p>
    <p class="done-text">That’s saved. Every platform you map gets someone to the right door.</p>
    <div class="done-actions">
      <button type="button" class="send" data-next="other">
        Map the other side
      </button>
      <button type="button" class="again" data-next="again">
        Map more
      </button>
    </div>
  </div>
</div>

<script>
  import { stations } from '../data/metro';
  import { FEATURES, type Feature, type Platform } from '../lib/survey';

  // Unsent answers, per station, so a lost signal or a reload doesn't lose them.
  const STORE = 'metroexit:door-drafts';
  type Draft = { platform: Platform | ''; doors: Record<number, Feature[]>; notes: string };
  const empty = (): Draft => ({ platform: '', doors: {}, notes: '' });

  const card = document.querySelector<HTMLElement>('.card')!;
  const root = card.querySelector<HTMLElement>('.survey')!;
  const form = root.querySelector<HTMLFormElement>('.survey-form')!;
  const done = root.querySelector<HTMLElement>('.survey-done')!;
  const status = form.querySelector<HTMLElement>('.status')!;
  const sendBtn = form.querySelector<HTMLButtonElement>('.send')!;
  const doorButtons = [...form.querySelectorAll<HTMLButtonElement>('.door')];
  const featureButtons = [...form.querySelectorAll<HTMLButtonElement>('.feature')];
  const notes = form.querySelector<HTMLInputElement>('.notes')!;

  const canMap = (id?: string) => !!id && stations.some((s) => s.id === id && s.status !== 'soon');
  // Door numbering is only confirmed on the original metro stations, not the converted Bankstown line.
  const unconfirmed = (id: string) => stations.some((s) => s.id === id && s.line === 'bankstown');

  function loadAll(): Record<string, Draft> {
    try {
      return JSON.parse(localStorage.getItem(STORE) ?? '{}') ?? {};
    } catch {
      return {};
    }
  }
  function saveAll() {
    try {
      localStorage.setItem(STORE, JSON.stringify(drafts));
    } catch {
      /* storage unavailable: answers last until the page closes */
    }
  }

  const drafts = loadAll();
  let station: string | null = null;
  let current: number | null = null;
  const draft = () => (drafts[station!] ??= empty());
  // Drafts saved before the Bankstown line opened call southbound "sydenham".
  for (const d of Object.values(drafts)) if ((d.platform as string) === 'sydenham') d.platform = 'bankstown';

  function render() {
    const d = draft();
    for (const el of form.querySelectorAll<HTMLInputElement>('[name=platform]')) el.checked = el.value === d.platform;
    for (const b of doorButtons) {
      const n = Number(b.dataset.door);
      const features = d.doors[n] ?? [];
      b.classList.toggle('marked', features.length > 0);
      b.setAttribute('aria-pressed', String(n === current));
      b.setAttribute(
        'aria-label',
        `Door ${n}${features.length ? `: ${features.map((f) => FEATURES[f]).join(', ')}` : ''}`,
      );
      b.querySelector('.door-icons')!.innerHTML = features.map((f) => `<svg><use href="#i-${f}"/></svg>`).join('');
    }
    form.querySelector<HTMLElement>('.pick-door')!.hidden = current !== null;
    form.querySelector<HTMLElement>('.features')!.hidden = current === null;
    if (current !== null) {
      form.querySelector('.panel-door')!.textContent = String(current);
      const features = d.doors[current] ?? [];
      for (const b of featureButtons)
        b.setAttribute('aria-pressed', String(features.includes(b.dataset.feature as Feature)));
    }
    if (document.activeElement !== notes) notes.value = d.notes;
    form.querySelector<HTMLElement>('.door-check')!.hidden = !unconfirmed(station!);
  }

  /** Shows the form when the station on the card is the one picked, and it's open. */
  function sync() {
    const pinned = card.dataset.pinned || '';
    const shown = card.dataset.shown || '';
    const next = pinned && pinned === shown && canMap(pinned) ? pinned : null;
    card.classList.toggle('surveying', !!next);
    card.classList.toggle('can-survey', !next && canMap(shown));
    if (next === station) return;
    station = next;
    current = null;
    root.hidden = !station;
    form.hidden = false;
    done.hidden = true;
    status.textContent = '';
    if (station) render();
  }
  new MutationObserver(sync).observe(card, { attributes: true, attributeFilter: ['data-pinned', 'data-shown'] });
  sync();

  for (const b of doorButtons) {
    b.addEventListener('click', () => {
      const n = Number(b.dataset.door);
      current = current === n ? null : n;
      render();
    });
  }
  for (const b of featureButtons) {
    b.addEventListener('click', () => {
      if (current === null) return;
      const d = draft();
      const f = b.dataset.feature as Feature;
      const had = d.doors[current] ?? [];
      d.doors[current] = had.includes(f) ? had.filter((x) => x !== f) : [...had, f];
      if (!d.doors[current].length) delete d.doors[current];
      render();
      saveAll();
    });
  }
  form.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'platform') draft().platform = el.value as Platform;
    saveAll();
  });
  notes.addEventListener('input', () => {
    draft().notes = notes.value;
    saveAll();
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = draft();
    status.className = 'status error';
    if (!d.platform) return void (status.textContent = 'Pick a platform first.');
    if (!Object.keys(d.doors).length) return void (status.textContent = 'Tap a door and mark what’s there.');
    status.className = 'status';
    status.textContent = 'Sending…';
    sendBtn.disabled = true;
    try {
      const res = await fetch('/api/submissions', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          station,
          platform: d.platform,
          doors: Object.entries(d.doors).map(([door, features]) => ({ door: Number(door), features, note: '' })),
          notes: d.notes,
          name: '',
          website: form.querySelector<HTMLInputElement>('[name=website]')!.value,
        }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || 'Something went wrong.');
      status.textContent = '';
      done.dataset.platform = d.platform;
      done.querySelector<HTMLElement>('[data-next=other]')!.hidden = d.platform === 'both';
      drafts[station!] = empty();
      saveAll();
      current = null;
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      status.className = 'status error';
      status.textContent =
        err instanceof TypeError ? 'No signal? Your answers are saved. Tap Send again later.' : (err as Error).message;
    } finally {
      sendBtn.disabled = false;
    }
  });

  for (const b of done.querySelectorAll<HTMLButtonElement>('[data-next]')) {
    b.addEventListener('click', () => {
      const last = done.dataset.platform;
      if (b.dataset.next === 'other') draft().platform = last === 'tallawong' ? 'bankstown' : 'tallawong';
      saveAll();
      done.hidden = true;
      form.hidden = false;
      render();
    });
  }
</script>

<style>
  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .survey {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1.5px dashed #c9d3d5;
  }
  .survey p {
    margin: 0;
  }
  .survey-title {
    font-weight: 800;
    font-size: 15px;
  }

  .sides {
    display: flex;
    gap: 4px;
    margin: 8px 0 10px;
  }
  .sides label {
    position: relative;
    flex: 1;
  }
  .sides input {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .sides b {
    display: block;
    padding: 7px 2px;
    border: 1.5px solid #b9c4c6;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
    cursor: pointer;
  }
  .sides input:checked + b {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .sides input:focus-visible + b {
    outline: 2.5px solid var(--ink);
    outline-offset: 2px;
  }

  .train-end {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .train-end.right {
    text-align: right;
  }
  .cars {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 5px;
    margin: 3px 0;
  }
  .car {
    display: flex;
    gap: 3px;
    padding: 3px;
    border: 1.8px solid var(--ink);
    border-radius: 8px;
    background: #fff;
  }
  .door {
    flex: 1;
    min-width: 0;
    min-height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 4px 0;
    border: 1.5px solid #d5dcdd;
    border-radius: 6px;
    background: #f6f8f8;
    color: var(--ink);
    font: 800 14px/1 var(--font);
    cursor: pointer;
  }
  .door.marked {
    background: #e8f4f5;
    border-color: var(--line-nw);
  }
  .door[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--ink);
  }
  .door-icons {
    display: grid;
    grid-template-columns: repeat(2, 15px);
    justify-content: center;
    gap: 1px;
  }
  .door-icons:empty {
    display: none;
  }
  .door-icons :global(svg) {
    width: 15px;
    height: 15px;
  }
  .door-icons :global(svg:last-child:nth-child(odd)) {
    grid-column: span 2;
    justify-self: center;
  }
  .door-icons :global(svg:only-child) {
    width: 17px;
    height: 17px;
  }

  .pick-door {
    margin-top: 8px !important;
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  .features {
    margin-top: 8px;
  }
  .features-title {
    font-size: 13px;
    font-weight: 600;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    margin-top: 5px;
  }
  .feature {
    display: flex;
    align-items: center;
    gap: 4px;
    min-width: 0;
    min-height: 36px;
    padding: 4px 6px;
    border: 1.5px solid #b9c4c6;
    border-radius: 9px;
    background: #fff;
    color: var(--ink);
    font: 600 12px/1.1 var(--font);
    text-align: left;
    cursor: pointer;
  }
  .feature svg {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }
  .feature[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .door-check {
    margin-top: 10px !important;
    padding: 7px 10px;
    border-radius: 9px;
    background: #fff4d6;
    color: #6b4500;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }
  .notes {
    width: 100%;
    margin-top: 10px;
    padding: 8px 10px;
    font: 500 16px/1.2 var(--font);
    color: var(--ink);
    border: 1.5px solid #b9c4c6;
    border-radius: 9px;
  }
  .notes:focus {
    border-color: var(--ink);
    outline: none;
  }
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }
  .send-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .send,
  .again {
    flex-shrink: 0;
    padding: 9px 18px;
    border-radius: 99px;
    font: 700 14px/1 var(--font);
    color: var(--ink);
    cursor: pointer;
  }
  .send {
    border: 2px solid var(--ink);
    background: var(--accent);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .send:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }
  .send:disabled {
    opacity: 0.6;
  }
  .again {
    border: 1.5px dashed var(--muted);
    background: transparent;
  }
  .status {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--line-nw);
  }
  .status.error {
    color: #b3261e;
  }

  .done-title {
    font-weight: 800;
    font-size: 18px;
  }
  .done-text {
    margin-top: 4px !important;
    font-size: 13px;
    line-height: 1.4;
    color: #3f4b4e;
  }
  .done-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }
  [hidden] {
    display: none !important;
  }
</style>
